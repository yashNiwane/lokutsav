datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  JUDGE
  PARTICIPANT
}

enum CompetitionStatus {
  UPCOMING
  ACTIVE
  JUDGING
  COMPLETED
}

enum ParticipationCategory {
  HOUSEHOLD          // घरगुती गणपती सजावट
  SARVAJANIK_MANDAL  // सार्वजनिक गणेशोत्सव मंडळ
}

enum IdolType {
  SHADU_MATI_CLAY           // शाडू मातीची मूर्ती
  ECO_FRIENDLY_PAPER_PULP   // कागदी लगदा / पर्यावरणपूरक
  TRADITIONAL_OTHER         // पारंपारिक / इतर
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EntryStatus {
  PENDING_VERIFICATION
  APPROVED
  FLAGGED
  REJECTED
}

enum SponsorTier {
  TITLE
  POWERED_BY
  GOLD
  ASSOCIATE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String?
  role         Role         @default(PARTICIPANT)
  passwordHash String?
  evaluations  Evaluation[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Competition {
  id              String            @id @default(cuid())
  slug            String            @unique @default("ganeshutsav-2026")
  title           String            @default("Maharashtra Rajya Online Ganpati Decoration Competition 2026")
  titleMr         String            @default("महाराष्ट्र राज्य ऑनलाइन गणेश सजावट स्पर्धा 2026")
  description     String
  descriptionMr   String
  year            Int               @default(2026)
  entryFee        Int               @default(99)
  prizePoolText   String            @default("₹1,50,000+ in Cash & Gifts")
  prizePoolTextMr String            @default("₹1,50,000+ रोख व आकर्षक पारितोषिके")
  status          CompetitionStatus @default(ACTIVE)
  registrationEnd DateTime
  judgingEnd      DateTime
  entries         Participant[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Participant {
  id                 String                @id @default(cuid())
  ticketId           String                @unique // e.g. LOK-2026-8941
  competitionId      String
  competition        Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  fullName           String
  phone              String
  email              String
  district           String                // e.g. Pune, Mumbai, Kolhapur, Nagpur, etc.
  city               String
  address            String
  category           ParticipationCategory @default(HOUSEHOLD)
  idolType           IdolType              @default(SHADU_MATI_CLAY)
  themeTitle         String
  themeDescription   String
  materialsUsed      String?
  photoUrls          String                // JSON array of file paths / URLs
  videoUrl           String?               // Link or uploaded local path
  entryFee           Int                   @default(99)
  paymentStatus      PaymentStatus         @default(PENDING)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  termsAccepted      Boolean               @default(true)
  termsAcceptedAt    DateTime?             @default(now())
  referralCode       String?               // e.g. LOK-2026-8941
  referredBy         String?               // Ticket ID of person who referred
  referralCount      Int                   @default(0)
  status             EntryStatus           @default(PENDING_VERIFICATION)
  finalScore         Float?
  finalRank          Int?                  // 1 to 10 for official top 10 winners
  evaluations        Evaluation[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([district])
  @@index([paymentStatus])
  @@index([status])
  @@index([finalRank])
}

model JudgingCriterion {
  id            String   @id @default(cuid())
  name          String
  nameMr        String
  description   String
  descriptionMr String
  maxScore      Int      @default(10)
  weight        Float    @default(1.0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

model Evaluation {
  id             String      @id @default(cuid())
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  judgeId        String
  judge          User        @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  criteriaScores String      // JSON: { "criterionId": score }
  totalScore     Float
  remarks        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([participantId, judgeId])
}

model Sponsor {
  id                   String      @id @default(cuid())
  name                 String
  tier                 SponsorTier @default(GOLD)
  logoUrl              String
  websiteUrl           String?
  sponsoredCategory    String?
  sponsoredCategoryMr  String?
  description          String?
  descriptionMr        String?
  sortOrder            Int         @default(0)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model FaqItem {
  id        String   @id @default(cuid())
  question   String
  questionMr String
  answer     String
  answerMr   String
  category   String   @default("general")
  sortOrder  Int      @default(0)
}

model UserJourneySession {
  id               String             @id @default(cuid())
  sessionId        String             @unique
  currentStep      Int                @default(1)
  maxStepReached   Int                @default(1)
  stageName        String             @default("STEP_1_PERSONAL")
  isCompleted      Boolean            @default(false)
  droppedOffAt     String?            // e.g. "STEP_1_PERSONAL", "STEP_2_DECORATION", "STEP_3_PAYMENT"
  dropOffField     String?            // e.g. "photos", "phone", "razorpay_modal"
  category         String?            // e.g. "HOUSEHOLD", "MANDAL"
  district         String?            // e.g. "Pune"
  city             String?            // e.g. "Haveli"
  address          String?            // e.g. "Flat 101, Shivneri..."
  fullName         String?            // e.g. "Rahul Patil"
  phone            String?            // e.g. "9876543210"
  email            String?            // e.g. "rahul@gmail.com"
  idolType         String?            // e.g. "SHADU_MATI_CLAY", "TRADITIONAL_POP"
  themeTitle       String?            // e.g. "Eco-friendly Fort"
  themeDescription String?            // Description of theme
  materialsUsed    String?            // Bamboo, paper, etc.
  photoUrls        String?            // JSON string array of photo URLs
  photosCount      Int                @default(0)
  videoUrl         String?            // Video link or uploaded path
  hasVideo         Boolean            @default(false)
  referredBy       String?            // Referral code
  ticketId         String?            // Ticket ID if generated
  paymentStatus    String             @default("NOT_INITIATED")
  deviceType       String?            @default("mobile")
  referrer         String?
  source           String?
  formDataJson     String?            // Complete JSON snapshot of all fields
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  events           UserJourneyEvent[]

  @@index([stageName])
  @@index([isCompleted])
  @@index([droppedOffAt])
  @@index([createdAt])
  @@index([phone])
}

model UserJourneyEvent {
  id          String              @id @default(cuid())
  sessionId   String
  session     UserJourneySession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  eventType   String              // "STEP_ENTER", "FIELD_INTERACTION", "PHOTO_UPLOAD", "PAYMENT_INITIATED", "PAYMENT_COMPLETED", "DROP_OFF"
  step        Int                 @default(1)
  stageName   String
  field       String?
  metadata    String?             // JSON string for arbitrary extra details
  createdAt   DateTime            @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([stageName])
  @@index([createdAt])
}

